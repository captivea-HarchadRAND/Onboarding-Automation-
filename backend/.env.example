# ═══════════════════════════════════════════════════════════════════════════════
#  Configuration du backend — copier ce fichier en `.env` (jamais le commiter).
#  Seules les variables réellement lues par le code sont listées ici.
#  [requis]    : l'application ne fonctionne pas correctement sans.
#  [facultatif]: valeur par défaut raisonnable, ou fonctionnalité optionnelle.
#  Les réglages métier (groupes, pays, domaines, schéma d'onboarding…) ne se mettent PAS ici :
#  ils se règlent dans l'application (Onboarding → Administration) et sont stockés en base.
# ═══════════════════════════════════════════════════════════════════════════════


# ─── 1. Microsoft Entra ID (Azure AD) ─────────────────────────────────────────
# Une seule app Entra sert à tout : Graph (comptes, groupes, licences), connexion Microsoft (SSO)
# et lecture des rapports SharePoint.
# [requis]
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# [requis]
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# [requis] valeur du secret (pas son ID)
AZURE_CLIENT_SECRET=


# ─── 2. Serveur ───────────────────────────────────────────────────────────────
# [facultatif] 8081 par défaut
PORT=8081
# Adresse publique du site, SANS « / » final. Sert à la sécurité CORS et à l'adresse de retour de la
# connexion Microsoft (<FRONTEND_URL>/api/auth/microsoft/callback). Obligatoire en production.
# Local : http://localhost:5175   |   VPS : https://onboarding.captivea.com
# [requis]
FRONTEND_URL=http://localhost:5175
# [facultatif] « production » sur le VPS (active aussi COOKIE_SECURE)
NODE_ENV=
# [facultatif] true derrière HTTPS (forcé par NODE_ENV=production)
COOKIE_SECURE=false
# [facultatif] true derrière Nginx, pour lire la vraie IP des clients
TRUST_PROXY=
# [facultatif] dossier de la base SQLite (défaut : backend/data)
DATA_DIR=


# ─── 3. Connexion à l'application ────────────────────────────────────────────
# Connexion normale : Microsoft (SSO). Le compte doit exister dans « Gestion du portail ».
# URI à déclarer dans Entra (plateforme « Web », jamais « Single-page application »).
# À renseigner seulement si elle diffère de <FRONTEND_URL>/api/auth/microsoft/callback.
# [facultatif]
MICROSOFT_REDIRECT_URI=

# Super administrateurs : seuls autorisés à ouvrir « Gestion du portail » (utilisateurs et accès).
# Adresses séparées par des virgules. À définir explicitement sur le VPS : sans elle, PERSONNE n'est super admin.
# [requis]
SUPER_ADMIN_EMAILS=prenom.nom@captivea.com

# Code de confirmation IT demandé avant de LANCER un onboarding (partagé entre opérateurs).
# Sans lui, le lancement d'un onboarding est impossible.
# [requis]
LAUNCH_PASSWORD=

# Accès de secours par mot de passe (page /login/backup, administrateurs uniquement).
# Compte créé au tout premier démarrage si aucun administrateur n'existe. Après cela, ces deux lignes
# n'ont plus d'effet : supprime-les du fichier (un mot de passe en clair n'a rien à y faire).
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Accès « break-glass » : ces identifiants permettent TOUJOURS de se connecter en admin, même si le mot
# de passe en base est perdu. Mot de passe fort, secret. Laisser vide pour désactiver.
RECOVERY_ADMIN_EMAIL=
RECOVERY_ADMIN_PASSWORD=


# ─── 4. Email (code 2FA de la connexion de secours) ──────────────────────────
# Sans SMTP_USER ni SMTP_FROM, la 2FA par email est désactivée.
# [facultatif]
SMTP_HOST=smtp.office365.com
# [facultatif]
SMTP_PORT=587
# SMTP_USER compte d'envoi (sert aussi d'expéditeur)
SMTP_USER=
SMTP_PASS=
# [facultatif] expéditeur, seulement s'il diffère de SMTP_USER
SMTP_FROM=


# ─── 5. Onboarding : valeurs de repli ────────────────────────────────────────
# Les valeurs saisies dans l'application (Onboarding → Administration) l'emportent sur celles-ci.
# DEFAULT_DOMAIN domaine email proposé par défaut
DEFAULT_DOMAIN=monentreprise.com
# USAGE_LOCATION code pays ISO pour l'assignation de licence
USAGE_LOCATION=FR
# FORCE_CHANGE_PASSWORD true : le nouvel employé change son mot de passe à la 1re connexion
FORCE_CHANGE_PASSWORD=true

# GitHub : invitation automatique dans l'organisation (désactivé sans jeton)
# GITHUB_TOKEN jeton avec le droit admin:org
GITHUB_TOKEN=
# [facultatif] slug de l'organisation
GITHUB_ORG=Riss-Group
# [facultatif] équipe à laquelle ajouter chaque nouveau membre
GITHUB_TEAM_SLUG=all

# Exchange Online (listes de distribution, boîtes partagées) : script /opt/scripts/exchange.ps1 sur le VPS
# EXCHANGE_APP_ID Client ID de l'app Exchange (peut être AZURE_CLIENT_ID)
EXCHANGE_APP_ID=
# EXCHANGE_CERT_PASSWORD mot de passe du certificat /opt/exchange.pfx
EXCHANGE_CERT_PASSWORD=


# ─── 6. Monitoring des licences IA ───────────────────────────────────────────
# Deux façons d'alimenter la page, combinables :
#  (a) le workflow n8n envoie les relevés à l'application ;
#  (b) l'application relit les rapports Excel dans SharePoint (lecture seule).

# (a) Jeton que n8n présente pour envoyer ses relevés (24 caractères minimum, secret).
#     Sans lui, la route d'envoi est fermée.
MONITORING_INGEST_TOKEN=

# (b) SharePoint. Active la synchronisation (bouton + automatique toutes les 6 h).
#     Permission requise sur l'app Entra : Sites.Selected, avec droit « read » sur le site.
# MONITORING_SP_DRIVE_ID identifiant de la bibliothèque de documents (b!…)
MONITORING_SP_DRIVE_ID=
# Chemins des rapports : à régler de préférence dans Monitoring → Administration. Valeurs par défaut :
#   <Knowledge/IT knowledge/Management/SI/AI/Captivea France>/<Claude|ChatGPT|Fireflies>/Report/…
MONITORING_SP_PATH_CLAUDE=
MONITORING_SP_PATH_CHATGPT=
MONITORING_SP_PATH_FIREFLIES=
# App Entra dédiée à la lecture SharePoint (facultatif ; à défaut, les AZURE_* ci-dessus sont utilisés)
MONITORING_SP_TENANT_ID=
MONITORING_SP_CLIENT_ID=
MONITORING_SP_CLIENT_SECRET=


# ─── 7. Mode développement (jamais sur le VPS) ───────────────────────────────
# true : tous les appels Graph sont simulés, aucun compte Microsoft 365 réel n'est créé,
# la connexion Microsoft est simulée (premier administrateur), et la synchro SharePoint est désactivée.
# MOCK_GRAPH=true
# Simuler un échec à une étape pour tester le rollback : 1 = création du compte, 2 = groupe, 3 = licence.
# MOCK_FAIL_STEP=0
# Durée simulée de chaque étape, en millisecondes (défaut : 1200).
# MOCK_DELAY_MS=1200
